# YouPI Test Store — Environment
PORT=4000

# YouPI-PG service URLs (default local dev ports)
YOUPI_API_URL=http://localhost:6100

# Default merchant (seeded at startup by youpi-pg migration)
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001

# Leave these empty — server.js auto-reads them from youpi-pg/data/.secrets/
# YOUPI_ADMIN_TOKEN=
# YOUPI_MERCHANT_KEY=
# YOUPI_WEBHOOK_SECRET=
